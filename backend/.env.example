# Google OAuth client — https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered in the Google Cloud console exactly.
REDIRECT_URI=http://localhost:8000/auth/google/callback

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Set to true to fake a signed-in user and skip Google entirely.
# Convenient for frontend work; never enable in production.
DEV_LOGIN=false
